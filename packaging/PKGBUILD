# Maintainer: MD. Habibullah Sharif
pkgname=heliograph
pkgver=0.1.0
pkgrel=1
pkgdesc="A fast, private media library and player for Linux"
arch=('any')
url="https://github.com/md8-habibullah/heliograph"
license=('MIT')
depends=('python' 'ffmpeg')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('python-pillow: faster picture headers and thumbnails'
            'chromium: window (any Chromium-based browser works)'
            'imagemagick: extra picture formats'
            'libheif: HEIC pictures (heif-convert)'
            'libraw: camera RAW pictures (dcraw_emu)'
            'mpv: "Play with mpv" action'
            'libva-utils: GPU video acceleration check')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')   # replace with the real checksum of the release tarball (updpkgsums)

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests -t tests
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/dev.habibullah.Heliograph.desktop "$pkgdir/usr/share/applications/dev.habibullah.Heliograph.desktop"
  install -Dm644 packaging/dev.habibullah.Heliograph.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.habibullah.Heliograph.svg"
  install -Dm644 packaging/dev.habibullah.Heliograph.metainfo.xml "$pkgdir/usr/share/metainfo/dev.habibullah.Heliograph.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
